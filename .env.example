# Public env vars — exposed to browser, MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="通用比赛管理评审系统"

# 后端接口地址。
# - 开发环境（pnpm dev）留空即可，会走 next.config.ts 中的 /api 代理
# - 生产 / Tauri 桌面端为静态导出，必须填写绝对地址
NEXT_PUBLIC_API_BASE_URL=https://approve.sast.fun/api

# 开发代理的目标后端（仅 pnpm dev 生效）
NEXT_PUBLIC_API_ORIGIN=https://approve.sast.fun/api

# 前端异常上报（可选）。留空则完全不初始化 Sentry，也不会有任何外部请求。
# 旧版 approval-system 使用的 DSN：
# NEXT_PUBLIC_SENTRY_DSN=https://1c5ba9e4927f4530e4edff132d922d71@o4507027967967232.ingest.us.sentry.io/4507027970457600
NEXT_PUBLIC_SENTRY_DSN=

# 上报中标记的版本号（可选）
NEXT_PUBLIC_APP_VERSION=3.0.0
